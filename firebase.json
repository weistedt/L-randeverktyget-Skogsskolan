{
  "hosting": {
    "public": "dist/web",
    "ignore": ["**/.*"],
    "headers": [
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/print/*.pdf", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "/print/manifest.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules" }
}

rules_version = '2';
// Skogsskolan: varje inloggad familj läser och skriver bara sina egna dokument,
// data/users/<uid>/familj och data/users/<uid>/<barn>~<bok>.
// meddelanden: en inloggad kan skicka i eget namn, men ingen kan läsa eller ändra dem från appen.
service cloud.firestore {
  match /databases/{database}/documents {
    match /data/users/{uid}/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && docId.size() <= 40
        && request.resource.data.keys().size() <= 12;
    }
    match /meddelanden/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['typ', 'text', 'om', 'uid', 'email', 't'])
        && request.resource.data.keys().hasAll(['typ', 'text', 'om', 'uid', 'email', 't'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.typ in ['bok', 'fel', 'annat']
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 3
        && request.resource.data.text.size() <= 1000
        && request.resource.data.om is string
        && request.resource.data.om.size() <= 120
        && request.resource.data.t == request.time;
    }
  }
}
